table HandshakeAck {
  request_time_utc:int64;
  response_time_utc:int64;
  session_id:uint64;
  package_name:string;
  package_version:string;
  package_build_number:string;
  hostname:string;
  username:string;
  process_id:uint64;
  service_name:string;
  api_name:string;
  api:uint8;
  instance:uint8;
  is_uat:bool;
}
